{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Majo Desktop",
  "identifier": "io.majo.desktop",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:5173/tauri.html",
    "beforeDevCommand": "vite --mode tauri",
    "beforeBuildCommand": "npm run build:tauri-bootstrap"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Majo Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "binaries/jre",
      "binaries/majo-backend.jar"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese",
          "Indonesian",
          "Japanese",
          "Russian",
          "PortugueseBR",
          "Vietnamese"
        ],
        "customLanguageFiles": {
          "English": "nsis-languages/English.nsh",
          "SimpChinese": "nsis-languages/SimpChinese.nsh",
          "Indonesian": "nsis-languages/Indonesian.nsh",
          "Japanese": "nsis-languages/Japanese.nsh",
          "Russian": "nsis-languages/Russian.nsh",
          "PortugueseBR": "nsis-languages/PortugueseBR.nsh"
        },
        "compression": "zlib",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNERDRDQ5QTgwMzY3MDcKUldRSFp3T29TYzFOZThya0NLZUJlUjd6Q1A5d0dsY2hpUTFKeSsxNXMxelpMUkxWdXBqQjRLV1oK",
      "endpoints": ["https://github.com/yhnnhyyhnn/majo/releases/latest/download/latest.json"]
    }
  }
}
